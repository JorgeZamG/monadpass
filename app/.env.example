# ── Network ───────────────────────────────────────────────
# NEXT_PUBLIC_CHAIN: "monadTestnet" | "hardhat"  (default: hardhat)
NEXT_PUBLIC_CHAIN=monadTestnet
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_CHAIN_NAME=Monad Testnet
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz

# ── Contract addresses ─────────────────────────────────────
# Fill after deploying:  npx hardhat run scripts/deploy.ts --network monadTestnet
NEXT_PUBLIC_MONADPASS_CORE_ADDRESS=0x...
NEXT_PUBLIC_EVENT_TICKET_ADDRESS=0x...
NEXT_PUBLIC_COMMEMORATIVE_BADGE_ADDRESS=0x...

